# Diisi di root, dipakai oleh docker-compose.yml (docker compose baca .env otomatis)

# --- Supabase (dari Project Settings > API di dashboard Supabase) ---
# Project ini pakai skema API key baru Supabase (sb_publishable_/sb_secret_) dengan
# JWT signing asimetris (ES256 via JWKS) — TIDAK ada JWT secret statis yang perlu disimpan;
# backend memverifikasi token lewat {SUPABASE_URL}/auth/v1/.well-known/jwks.json (publik).
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx

# --- Nilai yang sama tapi untuk sisi frontend (public, aman diekspos ke browser) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
