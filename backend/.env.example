# Supabase project URL, e.g. https://xxxxxxxxxxxx.supabase.co
SUPABASE_URL=

# Service role key (secret) — Supabase Dashboard > Project Settings > API.
# Bypasses RLS; never expose this to the frontend or commit a real value.
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated list of origins allowed to call this API.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Max upload size (KTP/SIM/STNK/POD photos) in megabytes. Optional — defaults to 5.
MAX_UPLOAD_SIZE_MB=5
